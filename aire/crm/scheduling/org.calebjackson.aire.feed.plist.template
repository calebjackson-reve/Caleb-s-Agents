<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.calebjackson.aire.feed</string>
	<key>ProgramArguments</key>
	<array>__HOST_GUARD__
		<string>/bin/sh</string>
		<string>__REPO__/aire/crm/refresh_feed.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AIRE_HOME</key>
		<string>__AIRE_HOME__</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>StandardErrorPath</key>
	<string>__AIRE_HOME__/logs/feed.launchd.err</string>
</dict>
</plist>
