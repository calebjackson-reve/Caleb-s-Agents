<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Pipeline server at login. install.sh fills in __HOME__ and __REPO__ and copies this to ~/Library/LaunchAgents. -->
  <key>Label</key><string>org.calebjackson.aire.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.aire/venv/bin/python</string>
    <string>__REPO__/aire/pipeline-app/app.py</string>
    <string>--no-open</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/aire/pipeline-app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PIPELINE_PORT</key><string>4747</string>
    <!-- dry until Caleb flips it: live sends texts through Messages and email through Gmail -->
    <key>PIPELINE_SENDER</key><string>dry</string>
    <key>PIPELINE_MAX_TEXTS</key><string>25</string>
    <key>PIPELINE_MAX_EMAILS</key><string>25</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.aire/logs/pipeline.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.aire/logs/pipeline.log</string>
</dict>
</plist>
