<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Command Center sync: one pass every 5 minutes, each read on its own pace. install-sync.sh fills in __HOME__ and __REPO__. -->
	<key>Label</key>
	<string>org.calebjackson.aire.ccsync</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__REPO__/aire/pipeline-app/cc_sync.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TZ</key>
		<string>America/Chicago</string>
	</dict>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.aire/logs/ccsync.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.aire/logs/ccsync.log</string>
</dict>
</plist>
