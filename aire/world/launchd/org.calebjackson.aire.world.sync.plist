<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AIRE World sync: the CRM sheet into data.json every 5 minutes. install.sh fills in __HOME__ and __REPO__. -->
	<key>Label</key>
	<string>org.calebjackson.aire.world.sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__REPO__/aire/world/sync.py</string>
		<string>--loop</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.aire/logs/world.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.aire/logs/world.err</string>
</dict>
</plist>
