{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daily-executive-planning output",
  "type": "object",
  "required": [
    "aire_prepares",
    "assumptions",
    "caleb_decisions",
    "critical_path",
    "day",
    "direction",
    "ordered_items",
    "parallelizable",
    "replanning_triggers",
    "top_outcomes",
    "uncertainty",
    "why_this_beats_alternatives"
  ],
  "additionalProperties": false,
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ordered_items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "key",
          "reason",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_window": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "maxItems": 25
    },
    "critical_path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 12
    },
    "parallelizable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 12
    },
    "aire_prepares": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "what"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "maxItems": 8
    },
    "caleb_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "decision"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "maxItems": 6
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "falsified_by"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "falsified_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "maxItems": 5
    },
    "replanning_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 8
    },
    "why_this_beats_alternatives": {
      "type": "string",
      "minLength": 20,
      "maxLength": 900
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 6
    },
    "direction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "top_outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    }
  }
}
