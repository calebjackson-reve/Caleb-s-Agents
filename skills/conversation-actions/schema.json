{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conversation-actions.v1",
  "type": "object",
  "required": ["suggestions", "summary"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "maxLength": 240, "description": "One plain sentence: what this person wants and where the conversation stands."},
    "suggestions": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["kind", "title", "owner", "excerpt", "evidence_ids", "why", "evidence_class", "missing", "proposed_start", "proposed_end", "all_day", "deadline", "time_words"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["appointment", "event", "deadline", "followup", "question", "promise", "document", "task", "transaction"]},
          "title": {"type": "string", "maxLength": 120},
          "owner": {"type": "string", "enum": ["caleb", "them"]},
          "excerpt": {"type": "string", "maxLength": 200, "description": "Verbatim words from one message in the conversation."},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
          "why": {"type": "string", "maxLength": 200},
          "evidence_class": {"type": "string", "enum": ["verified_fact", "reported_claim", "inference", "prediction"]},
          "missing": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 120}},
          "proposed_start": {"type": ["string", "null"], "description": "ISO 8601 with offset, America/Chicago, only when the words name a date and time."},
          "proposed_end": {"type": ["string", "null"]},
          "all_day": {"type": "boolean"},
          "deadline": {"type": ["string", "null"], "description": "ISO date when the words name a due date."},
          "time_words": {"type": ["string", "null"], "maxLength": 80, "description": "The exact time or date words from the message, e.g. 'tomorrow at 2' or 'next Friday'."}
        }
      }
    }
  }
}
