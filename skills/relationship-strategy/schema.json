{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relationship-strategy output",
  "type": "object",
  "required": ["person_id", "outcome", "history_summary", "open_loops", "unanswered_questions", "signals", "value_to_offer", "next_move", "reasons_not_to_contact", "caleb_decisions", "assumptions", "replanning_triggers", "uncertainty"],
  "additionalProperties": false,
  "properties": {
    "person_id": {"type": "integer"},
    "outcome": {"type": "string", "minLength": 5},
    "history_summary": {"type": "string", "minLength": 5},
    "open_loops": {"type": "array", "items": {"type": "object", "required": ["kind", "owner", "detail", "evidence"], "additionalProperties": false,
      "properties": {"kind": {"type": "string"}, "owner": {"enum": ["caleb", "contact"]}, "detail": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}},
    "unanswered_questions": {"type": "array", "items": {"type": "object", "required": ["question", "asked_by", "evidence"], "additionalProperties": false,
      "properties": {"question": {"type": "string"}, "asked_by": {"enum": ["caleb", "contact"]}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}},
    "signals": {"type": "array", "items": {"type": "object", "required": ["kind", "reasoning", "evidence"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["cooling", "strengthening", "steady", "new", "too_little_history"]}, "reasoning": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}},
    "value_to_offer": {"type": "array", "items": {"type": "string"}},
    "next_move": {"type": "object", "required": ["kind", "text", "owner", "authority"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["reply", "keep_promise", "close_thread", "deal_touch", "reconnect", "wait", "none"]}, "text": {"type": "string"}, "owner": {"enum": ["aire", "caleb"]}, "authority": {"enum": ["acts_alone", "prepares", "caleb_only"]}}},
    "reasons_not_to_contact": {"type": "array", "items": {"type": "string"}},
    "caleb_decisions": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "object", "required": ["statement", "falsified_by"], "additionalProperties": false,
      "properties": {"statement": {"type": "string"}, "falsified_by": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}}},
    "replanning_triggers": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}}
  }
}
